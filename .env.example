# Copy this file to .env and fill in what you have.
# Both are optional. With neither set, the deterministic rule-based
# NL->SQL translator is used automatically (see README).

# Anthropic API key -- if set, real LLM-backed NL->SQL generation via Claude is used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# OpenAI API key -- used only if ANTHROPIC_API_KEY is not set.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# SQLite database paths (created by `text-to-sql-mcp init-db`).
CIVIC_DB_PATH=data/civic.db
APP_DB_PATH=data/app.db

# Row-count threshold above which a table is considered "large" for the
# missing-WHERE-clause validator check.
LARGE_TABLE_ROW_THRESHOLD=500

# Max rows returned to the caller for any single query.
MAX_RESULT_ROWS=200
